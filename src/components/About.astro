---
import SectionHead from "./SectionHead.astro";
import { getLangFromUrl, useTranslations } from "../i18n";
import { cvPath, social } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const experience = [
	{ date: t("about_web_date"), role: t("about_web_role"), desc: t("about_web_desc") },
	{ date: t("about_support_date"), role: t("about_support_role"), desc: t("about_support_desc") },
	{ date: t("about_freelance_date"), role: t("about_freelance_role"), desc: t("about_freelance_desc") },
];
---

<section class="about section-pad" id="about" aria-labelledby="about-title">
	<div class="u-shell">
		<SectionHead
			eyebrow={t("about_eyebrow")}
			id="about-title"
			title={t("about_title")}
			intro={t("about_desc")}
		/>

		<div class="about__grid">
			<aside class="bridge">
				<p class="u-meta">{t("about_bridge_title")}</p>
				<p class="bridge__text">{t("about_bridge_desc")}</p>
				<dl>
					<div>
						<dt class="u-meta">{t("about_education_label")}</dt>
						<dd>{t("about_education_value")}</dd>
					</div>
					<div>
						<dt class="u-meta">{t("about_language_label")}</dt>
						<dd>{t("about_language_value")}</dd>
					</div>
				</dl>
				<div class="bridge__actions">
					<a class="bridge__cv" href={cvPath} download>{t("btn_cv")} <span aria-hidden="true">↗</span></a>
					<a class="bridge__github" href={social.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
				</div>
			</aside>

		<div class="timeline">
			<p class="timeline__label u-meta">{t("about_trajectory_title")}</p>
			<ol>
				{experience.map((item, index) => (
					<li>
						<div class="timeline__date u-meta"><span>0{index + 1}</span>{item.date}</div>
						<div>
							<h3>{item.role}</h3>
							<p>{item.desc}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</div>
	</div>
</section>

<style>
	.about {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.about__grid {
		display: grid;
		grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
		gap: clamp(2rem, 7vw, 8rem);
		align-items: start;
	}

	.bridge {
		position: sticky;
		top: 7rem;
		border-radius: var(--radius-md);
		padding: clamp(1.5rem, 3vw, 2.4rem);
		background: var(--color-ink);
		color: var(--color-text);
	}

	.bridge > .u-meta {
		margin-bottom: 2.5rem;
		color: var(--color-lime);
	}

	.bridge__text {
		margin-bottom: 3rem;
		font-size: clamp(1.2rem, 1.04rem + 0.6vw, 1.65rem);
		font-weight: 550;
		line-height: 1.35;
	}

	.bridge dl {
		margin: 0 0 2rem;
	}

	.bridge dl div {
		border-top: 1px solid var(--color-line-dark);
		padding-block: 1rem;
	}

	.bridge dt {
		margin-bottom: 0.35rem;
		color: var(--color-muted);
	}

	.bridge dd {
		margin: 0;
		color: var(--color-text-soft);
		font-size: 0.92rem;
		line-height: 1.45;
	}

	.bridge__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.bridge__cv,
	.bridge__github {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-lime);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.bridge__github {
		color: var(--color-text);
	}

	.timeline__label {
		margin-bottom: 1.5rem;
	}

	.timeline ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.timeline li {
		display: grid;
		grid-template-columns: minmax(8rem, 0.38fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		border-top: 1px solid var(--color-line-light);
		padding-block: clamp(1.75rem, 4vw, 3rem);
	}

	.timeline__date {
		display: flex;
		gap: 1.2rem;
		color: rgb(10 13 12 / 0.62);
	}

	.timeline__date span {
		color: var(--color-ink);
	}

	.timeline h3 {
		margin-bottom: 0.8rem;
		font-size: clamp(1.5rem, 2.4vw, 2.5rem);
		line-height: 1.05;
		letter-spacing: -0.035em;
	}

	.timeline p {
		max-width: 42rem;
		margin: 0;
		color: rgb(10 13 12 / 0.68);
		line-height: 1.55;
	}

	@media (width < 60rem) {
		.about__grid {
			grid-template-columns: 1fr;
		}

		.bridge {
			position: static;
		}
	}

	@media (width < 38rem) {
		.timeline li {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
