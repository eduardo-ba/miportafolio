---
import { Image } from "astro:assets";
import portrait from "../assets/luis-eduardo-barron.jpg";
import { getLangFromUrl, useTranslations } from "../i18n";
import { location, social } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero u-shell" aria-labelledby="hero-name">
	<p class="hero__issue u-meta">Portfolio — Issue 001 / {location}</p>

	<h1 class="hero__name" id="hero-name">{t("home_name")}</h1>

	<div class="hero__body">
		<Image
			class="hero__portrait"
			src={portrait}
			alt={t("home_img_alt")}
			widths={[320, 560, 900]}
			sizes="(width < 48rem) 60vw, 24rem"
			loading="eager"
			fetchpriority="high"
		/>

		<div class="hero__aside">
			<p class="hero__role">{t("home_subtitle")}</p>
			<dl class="hero__record u-meta">
				<div><dt>Base</dt><dd>{location}</dd></div>
				<div><dt>Archive ID</dt><dd>LEB-001</dd></div>
			</dl>
			<ul class="hero__links u-meta">
				<li><a href={social.github}>GitHub</a></li>
				<li><a href={social.linkedin}>LinkedIn</a></li>
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-section) calc(var(--space-section) * 0.6);
	}

	.hero__issue {
		margin: 0 0 1.5rem;
	}

	/* §8: jerarquía por tamaño + ancho, no por peso. */
	.hero__name {
		font-size: var(--text-display);
		font-variation-settings: "wdth" 112;
		max-width: 12ch;
		text-wrap: initial;
		margin: 0;
	}

	.hero__body {
		display: grid;
		grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: end;
		margin-top: clamp(2rem, 5vw, 4rem);
	}

	/* §23: aristas rectas. Nada de retrato circular (§31). */
	.hero__portrait {
		width: 100%;
		height: auto;
		border: 1px solid var(--color-line);
		filter: grayscale(1) contrast(1.06);
	}

	.hero__role {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-variation-settings: "wdth" 104;
		font-weight: 600;
		line-height: 1.1;
		margin: 0 0 2rem;
		max-width: 20ch;
	}

	/* Registro tipo documento (§16). */
	.hero__record {
		display: grid;
		gap: 0.35rem;
		margin: 0 0 2rem;
		border-top: 1px solid var(--color-line);
		padding-top: 1rem;
	}

	.hero__record div {
		display: flex;
		gap: 0.75rem;
	}

	.hero__record dt {
		min-width: 7rem;
		color: var(--color-muted);
	}

	.hero__record dd {
		margin: 0;
		color: var(--color-ink);
	}

	.hero__links {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.hero__links a {
		text-decoration: none;
		border-bottom: 1px solid var(--color-line-strong);
		padding-bottom: 2px;
		transition: border-color var(--dur-micro) var(--ease-editorial);
	}

	.hero__links a:hover {
		border-bottom-color: var(--color-ink);
	}

	/* §27: móvil conserva la personalidad, solo se reordena. */
	@media (width < 48rem) {
		.hero__name {
			font-variation-settings: "wdth" 96;
			max-width: 100%;
		}

		.hero__body {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.hero__portrait {
			max-width: 60%;
		}
	}
</style>
