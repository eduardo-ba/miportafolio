---
interface Props {
	eyebrow: string;
	title: string;
	id: string;
	intro?: string;
}

const { eyebrow, title, id, intro } = Astro.props;
---

<header class="section-head">
	<p class="eyebrow section-head__eyebrow">{eyebrow}</p>
	<div class="section-head__main">
		<h2 id={id}>{title}</h2>
		{intro && <p>{intro}</p>}
	</div>
</header>

<style>
	.section-head {
		display: grid;
		grid-template-columns: minmax(9rem, 0.34fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}

	.section-head__eyebrow {
		margin-top: 0.45rem;
	}

	.section-head__main {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(15rem, 0.65fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: end;
	}

	.section-head h2 {
		margin: 0;
		font-size: clamp(2.6rem, 5vw, 5.8rem);
		font-variation-settings: "wdth" 106;
	}

	.section-head__main p {
		margin: 0 0 0.4rem;
		font-size: clamp(0.98rem, 0.92rem + 0.25vw, 1.15rem);
		line-height: 1.55;
		opacity: 0.7;
	}

	@media (width < 58rem) {
		.section-head,
		.section-head__main {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}

		.section-head__main p {
			max-width: 42rem;
		}
	}
</style>
