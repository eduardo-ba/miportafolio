---
import { getLangFromUrl, useTranslations } from "../i18n";
import { email, social } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="contact" id="contact" aria-labelledby="contact-title">
	<div class="u-shell">
		<p class="eyebrow contact__eyebrow">{t("contact_eyebrow")}</p>
		<div class="contact__main">
			<div>
				<h2 id="contact-title">{t("contact_title")}</h2>
				<p class="contact__desc">{t("contact_desc")}</p>
			</div>
			<a class="contact__mail" href={`mailto:${email}`}>
				<span class="u-meta">{t("contact_email_label")}</span>
				<strong>{email}</strong>
				<b aria-hidden="true">↗</b>
			</a>
		</div>

		<div class="contact__footer">
			<p class="u-meta">© {year} — {t("footer_copy")}</p>
			<nav aria-label="Social">
				<a href={social.github} target="_blank" rel="noreferrer">GitHub ↗</a>
				<a href={social.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<a href="#main">{t("back_to_top")} ↑</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.contact {
		position: relative;
		overflow: hidden;
		padding-block: var(--space-section) 2rem;
		background: var(--color-lime);
		color: var(--color-ink);
	}

	.contact::after {
		position: absolute;
		right: -5rem;
		bottom: -10rem;
		width: 30rem;
		height: 30rem;
		border: 1px solid rgb(10 13 12 / 0.18);
		border-radius: 50%;
		content: "";
	}

	.contact__eyebrow {
		margin-bottom: clamp(2rem, 5vw, 4rem);
	}

	.contact__main {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
		gap: clamp(3rem, 8vw, 9rem);
		align-items: end;
		padding-bottom: clamp(5rem, 10vw, 10rem);
	}

	.contact h2 {
		max-width: 10ch;
		margin-bottom: 1.5rem;
		font-size: clamp(3.2rem, 7.5vw, 8.5rem);
		font-variation-settings: "wdth" 108;
	}

	.contact__desc {
		max-width: 43rem;
		margin: 0;
		font-size: clamp(1rem, 0.92rem + 0.3vw, 1.2rem);
	}

	.contact__mail {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		border-top: 1px solid var(--color-ink);
		border-bottom: 1px solid var(--color-ink);
		padding-block: 1.3rem;
		text-decoration: none;
	}

	.contact__mail span,
	.contact__mail strong {
		grid-column: 1;
	}

	.contact__mail span {
		margin-bottom: 0.35rem;
		opacity: 0.55;
	}

	.contact__mail strong {
		overflow: hidden;
		font-size: clamp(1rem, 1.8vw, 1.5rem);
		text-overflow: ellipsis;
	}

	.contact__mail b {
		grid-column: 2;
		grid-row: 1 / 3;
		font-size: 1.8rem;
		font-weight: 450;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.contact__mail:hover b {
		transform: translate(0.3rem, -0.3rem);
	}

	.contact__footer {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border-top: 1px solid rgb(10 13 12 / 0.22);
		padding-top: 1.5rem;
	}

	.contact__footer p {
		margin: 0;
	}

	.contact__footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.contact__footer a {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.contact :focus-visible {
		outline-color: var(--color-ink);
	}

	@media (width < 58rem) {
		.contact__main {
			grid-template-columns: 1fr;
		}
	}

	@media (width < 42rem) {
		.contact__footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
