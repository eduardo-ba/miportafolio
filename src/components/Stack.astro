---
import SectionHead from "./SectionHead.astro";
import { getLangFromUrl, useTranslations } from "../i18n";
import { capabilities, skills } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="stack section-pad" id="stack" aria-labelledby="stack-title">
	<div class="u-shell">
		<SectionHead
			eyebrow={t("skills_eyebrow")}
			id="stack-title"
			title={t("skills_title")}
			intro={t("skills_intro")}
		/>

		<div class="stack__catalog">
			{skills.map((group) => (
				<article class="skill-group">
					<div class="skill-group__head">
						<span class="u-meta">{group.index}</span>
						<h3>{t(group.titleKey)}</h3>
					</div>
					<ul>
						{group.items.map((item) => <li>{item}</li>)}
					</ul>
				</article>
			))}
		</div>

		<div class="capabilities">
			{capabilities.map((capability, index) => (
				<article>
					<span class="capabilities__index u-meta">0{index + 1}</span>
					<h3>{t(capability.titleKey)}</h3>
					<p>{t(capability.descKey)}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.stack {
		background:
			radial-gradient(circle at 100% 25%, rgb(200 244 90 / 0.09), transparent 28rem),
			var(--color-bg);
	}

	.stack__catalog {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--color-line-dark);
		border-bottom: 1px solid var(--color-line-dark);
	}

	.skill-group {
		min-width: 0;
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	.skill-group + .skill-group {
		border-left: 1px solid var(--color-line-dark);
	}

	.skill-group__head {
		min-height: 7rem;
	}

	.skill-group__head span {
		display: block;
		margin-bottom: 1rem;
		color: var(--color-lime);
	}

	.skill-group h3 {
		margin: 0;
		font-size: clamp(1.3rem, 2vw, 2rem);
		letter-spacing: -0.03em;
	}

	.skill-group ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.skill-group li {
		border-top: 1px solid var(--color-line-dark);
		padding-block: 0.65rem;
		color: var(--color-text-soft);
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.capabilities {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: clamp(4rem, 8vw, 8rem);
	}

	.capabilities article {
		position: relative;
		min-height: 19rem;
		border: 1px solid var(--color-line-dark);
		border-radius: var(--radius-md);
		padding: clamp(1.5rem, 3vw, 2.2rem);
		background: var(--color-panel);
		transition: background-color var(--dur-ui) ease, transform var(--dur-ui) var(--ease-out);
	}

	.capabilities article:hover {
		transform: translateY(-0.25rem);
		background: #1d2421;
	}

	.capabilities__index {
		display: block;
		margin-bottom: clamp(3rem, 5vw, 5rem);
		color: var(--color-lime);
	}

	.capabilities h3 {
		margin-bottom: 1rem;
		font-size: clamp(1.7rem, 2.5vw, 2.6rem);
	}

	.capabilities p {
		margin: 0;
		color: var(--color-text-soft);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	@media (width < 66rem) {
		.stack__catalog {
			grid-template-columns: repeat(2, 1fr);
		}

		.skill-group:nth-child(3) {
			border-left: 0;
		}

		.skill-group:nth-child(n + 3) {
			border-top: 1px solid var(--color-line-dark);
		}
	}

	@media (width < 50rem) {
		.capabilities {
			grid-template-columns: 1fr;
		}

		.capabilities article {
			min-height: 15rem;
		}
	}

	@media (width < 35rem) {
		.stack__catalog {
			grid-template-columns: 1fr;
		}

		.skill-group + .skill-group,
		.skill-group:nth-child(3) {
			border-top: 1px solid var(--color-line-dark);
			border-left: 0;
		}
	}
</style>
