---
import SectionHead from "./SectionHead.astro";
import { getLangFromUrl, useTranslations } from "../i18n";
import { certifications } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="archive u-shell" aria-labelledby="archive-title">
	<SectionHead index="04" id="archive-title" title={t("addl_training_title")} />

	{/* §18: documentos de archivo, no tarjetas de certificado. */}
	<ul class="archive__list">
		{
			certifications.map((cert, i) => (
				<li class="doc">
					<span class="doc__id u-meta" aria-hidden="true">
						LEB-C{String(i + 1).padStart(2, "0")}
					</span>
					<a class="doc__name" href={cert.url}>
						{t(cert.labelKey)}
					</a>
					<span class="doc__issuer u-meta">{cert.issuer}</span>
					<span class="doc__type u-meta" aria-hidden="true">
						Certificate
					</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	.archive {
		padding-block: var(--space-section);
	}

	.archive__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-line);
	}

	/* Fila de índice/directorio: legible primero, retro después (§17). */
	.doc {
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 14rem) 7rem;
		gap: 1.5rem;
		align-items: baseline;
		border-bottom: 1px solid var(--color-line);
		padding-block: 1rem;
		transition: background-color var(--dur-micro) var(--ease-editorial);
	}

	.doc:hover {
		background: var(--color-paper-clean);
	}

	.doc__id {
		color: var(--color-muted);
	}

	.doc__name {
		font-family: var(--font-display);
		font-size: var(--text-md);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color var(--dur-micro) var(--ease-editorial);
	}

	.doc__name:hover {
		border-bottom-color: var(--color-ink);
	}

	.doc__type {
		text-align: right;
	}

	@media (width < 56rem) {
		.doc {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
		.doc__type {
			display: none;
		}
	}
</style>
