---
import SectionHead from "./SectionHead.astro";
import { getLangFromUrl, useTranslations } from "../i18n";
import { certifications } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="training section-pad" id="training" aria-labelledby="training-title">
	<div class="u-shell">
		<SectionHead
			eyebrow={t("certs_eyebrow")}
			id="training-title"
			title={t("certs_title")}
			intro={t("certs_intro")}
		/>

		<ul class="training__list">
			{certifications.map((cert, index) => (
				<li>
					<span class="training__index u-meta">C-{String(index + 1).padStart(2, "0")}</span>
					<div>
						<h3>{t(cert.labelKey)}</h3>
						<p class="u-meta">{cert.issuer}</p>
					</div>
					<a href={cert.url} target="_blank" rel="noreferrer">
						<span class="u-meta">{t("cert_verify")}</span><b aria-hidden="true">↗</b>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.training {
		border-top: 1px solid var(--color-line-light);
		background: var(--color-paper-soft);
		color: var(--color-ink);
	}

	.training__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-line-light);
	}

	.training__list li {
		display: grid;
		grid-template-columns: 5rem minmax(0, 1fr) auto;
		gap: clamp(1rem, 4vw, 4rem);
		align-items: center;
		border-bottom: 1px solid var(--color-line-light);
		padding-block: 1.35rem;
		transition: padding-inline var(--dur-ui) var(--ease-out), background-color var(--dur-fast) ease;
	}

	.training__list li:hover {
		padding-inline: 1rem;
		background: var(--color-paper);
	}

	.training__index {
		color: rgb(10 13 12 / 0.5);
	}

	.training h3 {
		margin-bottom: 0.35rem;
		font-size: clamp(1.2rem, 2vw, 1.8rem);
		line-height: 1.12;
		letter-spacing: -0.025em;
	}

	.training__list p {
		margin: 0;
		color: rgb(10 13 12 / 0.52);
	}

	.training__list a {
		display: flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
	}

	.training__list a b {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		place-items: center;
		border: 1px solid var(--color-line-light);
		border-radius: 50%;
		font-weight: 500;
		transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease;
	}

	.training__list a:hover b {
		transform: rotate(45deg);
		background: var(--color-lime);
	}

	@media (width < 42rem) {
		.training__list li {
			grid-template-columns: 3rem 1fr auto;
		}

		.training__list a span {
			display: none;
		}
	}
</style>
