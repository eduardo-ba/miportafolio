---
import {
	getLangFromUrl,
	useTranslations,
	localizePath,
	localeTags,
	languages,
	dictionaries,
} from "../i18n";

const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
const basePath = Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, "") || "/";
---

<nav class="lang-picker" aria-label={t("nav_language")}>
	<ul>
		{languages.map((lang) => {
			const isCurrent = lang === current;
			return (
				<li>
					<a
						href={localizePath(basePath, lang)}
						lang={localeTags[lang]}
						hreflang={localeTags[lang]}
						aria-current={isCurrent ? "page" : undefined}
					>
						{dictionaries[lang].lang_name}
					</a>
				</li>
			);
		})}
	</ul>
</nav>

<style>
	.lang-picker ul {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.lang-picker a {
		display: inline-flex;
		min-width: 2rem;
		min-height: 2.4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 700;
		text-decoration: none;
		transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease;
	}

	.lang-picker a:hover {
		color: var(--color-text);
	}

	.lang-picker a[aria-current="page"] {
		background: var(--color-lime);
		color: var(--color-ink);
	}
</style>
